  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "TRUMP:\nDer Pr\xE4sident der USA (auch bekannt als seniler, alter, sich
    in die Hose machender, Vollidiot) hat entschieden das die USA umbenannt werden
    sollen in UST (United States of Trump). Dazu sollen auch weitere Namens\xE4nderung
    statt finden von Historischen Figuren. So soll unteranderem Jesus zu Trump Senior
    umgetauft werden. Hilter soll zu Lefty McLeft Definitiv Left umbenannt werden,
    Elon Musk schlug vor Hitler einfach in Xitler umzubennen dies sei besser. Alle
    L\xE4nder sollen au\xDFerdem nun als Shit Hole Countrys benannt werden und dazu
    eine Skala von 1-10 erhalten, wobei 10 ein Land ist das Trump als gut empfindet
    und 1 ist ein Feind von Amerika. China und Russland sollen die einzigen Ausnahmen
    dieser Regel sein, so sollen beide umbenannt werden zu \"Shy Na\" und \"Bear
    with Oil\". Merz bat darum das man bitte Germany nicht in Shit Hole Country 6
    umbennen soll, er erinnert Trump daran das sein Gro\xDFvater ja auch Friedrich
    hie\xDF. Trump nahm dies zur Kenntnis und l\xE4sst Deutschland nun umbennen in
    \"Merz leck Eier\".   "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
